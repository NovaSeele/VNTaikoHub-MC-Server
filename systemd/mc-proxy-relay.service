[Unit]
Description=PROXY-protocol relay in front of Paper (nginx -> relay -> Paper)
After=network.target minecraft.service
Wants=minecraft.service
Before=nginx.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mc-dashboard/relay.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
